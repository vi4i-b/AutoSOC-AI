# Copy this file to .env and fill in your values.
# NEVER commit the real .env — it contains secrets.

# ── Telegram ─────────────────────────────────────────────────────────
# Bot token from @BotFather. Required for Telegram alerts.
TELEGRAM_BOT_TOKEN=
# Public link to your bot (shown in the UI "Open Bot" button).
TELEGRAM_BOT_URL=https://t.me/AutoSOC_Baku_Bot
# Optional: pre-set chat id (normally captured automatically via /start).
TELEGRAM_CHAT_ID=

# ── AI providers (all optional; the app falls back to built-in expert mode) ──
# NVIDIA-hosted models (integrate.api.nvidia.com).
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v3

# OpenAI / local Ollama for the security expert. AI_PROVIDER: auto | openai | ollama
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.1:8b

# ── Application (optional overrides) ─────────────────────────────────
# Data directory (default: %APPDATA%\AutoSOC on Windows, ~/.local/share/autosoc on Linux).
#AUTOSOC_DATA_DIR=
# Database path (default: <data dir>/soc_audit.db).
#AUTOSOC_DB_PATH=
# Bind address for canary decoy listeners (default 0.0.0.0 — reachable on the LAN by design).
#AUTOSOC_CANARY_HOST=
# Logging level: DEBUG | INFO | WARNING | ERROR
#AUTOSOC_LOG_LEVEL=INFO
